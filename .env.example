# ==============================================================================
# DeMegaPOS Environment Variables Blueprint
# Copy this file to .env in your root and packages/apps directories as needed.
# Never commit real credentials or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PRISMA ORM)
# ------------------------------------------------------------------------------
# All backend endpoints route directly to the database engine via DATABASE_URL.
# Prisma Studio is strictly an auxiliary visual inspector and is not a proxy.

# Option A: Supabase Managed Database (Recommended for Cloud/Production)
# Pooler (port 6543 for PgBouncer / transaction mode):
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL (port 5432 for session mode / migrations):
DIRECT_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Option B: Neon Serverless PostgreSQL
# DATABASE_URL="postgresql://[user]:[password]@[endpoint-id].neon.tech/demegapos?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://[user]:[password]@[endpoint-id].neon.tech/demegapos?sslmode=require"

# Option C: Railway PostgreSQL
# DATABASE_URL="postgresql://postgres:[password]@[railway-host]:[port]/railway"
# DIRECT_DATABASE_URL="postgresql://postgres:[password]@[railway-host]:[port]/railway"

# Option D: Local Containerized PostgreSQL (docker-compose up -d)
# DATABASE_URL="postgresql://admin:password@localhost:5432/demegapos?schema=public"
# DIRECT_DATABASE_URL="postgresql://admin:password@localhost:5432/demegapos?schema=public"

# ------------------------------------------------------------------------------
# 2. BACKEND & SECURITY SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-cryptographically-secure-64-character-hex-string

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (CACHE & QUEUES)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. CORS & FRONTEND ROUTING
# ------------------------------------------------------------------------------
FRONTEND_URL=https://demegapos.netlify.app
# Comma-separated list of allowed origin URLs
ALLOWED_ORIGINS=https://demegapos.netlify.app,https://demegapos.onrender.com,http://localhost:5173,http://localhost:5174

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATION PROVIDERS (Nodemailer / Resend)
# ------------------------------------------------------------------------------
MAIL_PROVIDER=GMAIL
# Options: GMAIL, RESEND, SMTP
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password

# Optional Resend Configuration:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxx
SMTP_FROM=DeMegaPOS <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 6. FRONTEND CLIENT APP (VITE)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# ------------------------------------------------------------------------------
# 7. SEED & ADMIN BOOTSTRAP (DB SEED SCRIPTS ONLY)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@demega.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_min_8_chars

