# Copy this file to .env or set the same variables in Vercel.
# Never commit real secrets.

# Backend / API
DATABASE_URL=postgresql://user:password@host:5432/demegapos?schema=public
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/demegapos?schema=public
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://demegapos.netlify.app
# Comma-separated list of allowed CORS origins (add your custom domain here when ready)
ALLOWED_ORIGINS=https://demegapos.netlify.app,http://localhost:5173
PORT=3000

# Frontend apps (Vite)
VITE_API_URL=https://your-backend-url.com
VITE_WS_URL=wss://your-backend-url.com
