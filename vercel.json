{
    "version": 2,
    "buildCommand": "turbo run build --filter=web-back-office",
    "outputDirectory": "apps/web-back-office/dist",
    "installCommand": "pnpm install --frozen-lockfile",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
