{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd apps/web-back-office && npm install",
  "buildCommand": "cd apps/web-back-office && npm run build",
  "outputDirectory": "apps/web-back-office/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
