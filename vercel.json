{
    "version": 2,
    "buildCommand": "pnpm --filter web-back-office build",
    "outputDirectory": "apps/web-back-office/dist",
    "installCommand": "pnpm install --frozen-lockfile",
    "framework": null,
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}