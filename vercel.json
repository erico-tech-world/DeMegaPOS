{
  "version": 2,
  "buildCommand": "cd ../.. && pnpm --filter \"@demegapos/db\" build && pnpm --filter \"demegapos-backend\" build",
  "outputDirectory": "apps/backend/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.js"
    }
  ]
}
