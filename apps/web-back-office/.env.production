# ─── DeMega POS — Frontend Production Environment Variables ──────────────────
# This file is committed to git and used by Vercel at build time.
# For local dev, copy this to .env.local and override as needed.
# ⚠️  Do NOT put secrets here — Vite exposes all VITE_* vars to the browser bundle.

# Backend API (Render-hosted Node.js/Fastify)
VITE_API_URL=https://demegapos.onrender.com

# Backend WebSocket (Render-hosted)
VITE_WS_URL=wss://demegapos.onrender.com
