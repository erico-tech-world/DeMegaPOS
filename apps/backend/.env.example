# =============================================================================
# DeMega POS — Backend Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# ⚠️  NEVER commit your actual .env file to source control.
# =============================================================================


# ─── DATABASE (SUPABASE CLOUD — RECOMMENDED FOR PRODUCTION) ───────────────────
#
# Two separate connection strings are REQUIRED for Prisma + Supabase:
#
# 1. DATABASE_URL  →  Transactional Pooler via PgBouncer (port 6543)
#    Purpose: Used by Prisma Client at runtime for all queries.
#    Required: pgbouncer=true query param to prevent prepared statement errors.
#
# 2. DIRECT_DATABASE_URL  →  Direct Session Connection (port 5432)
#    Purpose: Used by Prisma Migrate / db push / introspect ONLY.
#    Required: Must bypass PgBouncer — prepared statements are needed for migrations.
#
# Find these in: Supabase Dashboard → Project → Settings → Database → Connection string
#
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30"
DIRECT_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?connect_timeout=30"


# ─── DATABASE (LOCAL DOCKER — FOR DEV ONLY) ───────────────────────────────────
# Uncomment these and comment out the Supabase block above for local development:
#
# DATABASE_URL="postgresql://admin:password@localhost:5432/demegapos?schema=public"
# DIRECT_DATABASE_URL="postgresql://admin:password@localhost:5432/demegapos?schema=public"


# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Generate a secure 64-char hex string: openssl rand -hex 32
JWT_SECRET="your-64-char-hex-secret-here"


# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=3000


# ─── REDIS / UPSTASH ──────────────────────────────────────────────────────────
# Upstash Redis REST URL (serverless-compatible, no persistent TCP connection needed)
REDIS_URL="https://your-redis-instance.upstash.io"


# ─── CORS / FRONTEND ORIGINS ──────────────────────────────────────────────────
# Set to your production Vercel frontend URL
FRONTEND_URL=https://your-project.vercel.app
APP_BASE_URL=https://your-project.vercel.app

# Comma-separated list of all allowed origins
ALLOWED_ORIGINS=https://your-project.vercel.app,https://your-project.netlify.app,https://your-backend.onrender.com,http://localhost:5173,http://localhost:4173


# ─── MAIL (PRIMARY — RESEND) ──────────────────────────────────────────────────
# Recommended for cloud/Render deployments. Get key from: https://resend.com/api-keys
MAIL_PROVIDER="RESEND"
RESEND_API_KEY="re_your_resend_api_key"

# Resend SMTP relay settings (used by nodemailer transporter)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="resend"
SMTP_PASS="re_your_resend_api_key"
SMTP_FROM="DeMegaPOS <onboarding@resend.dev>"


# ─── MAIL (FALLBACK — GMAIL SMTP) ─────────────────────────────────────────────
# Used when primary Resend delivery fails.
# Use an App Password (not your Gmail password): https://myaccount.google.com/apppasswords
FALLBACK_SMTP_HOST="smtp.gmail.com"
FALLBACK_SMTP_PORT=587
FALLBACK_SMTP_SECURE=false
FALLBACK_SMTP_USER="your-gmail@gmail.com"
FALLBACK_SMTP_PASS="your-gmail-app-password"
FALLBACK_SMTP_FROM="DeMegaPOS <your-gmail@gmail.com>"


# ─── SMS — TWILIO (OPTIONAL) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""


# ─── PAYMENT GATEWAY — MONNIFY (OPTIONAL) ─────────────────────────────────────
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_BASE_URL="https://sandbox.monnify.com"


# ─── SEED & ADMIN BOOTSTRAP (USED ONLY BY DB SEED SCRIPTS) ────────────────────
# Provide these when running initial bootstrapping via `pnpm seed`.
# DO NOT commit real passwords or hardcode credentials in code.
INITIAL_ADMIN_EMAIL="admin@demega.com"
INITIAL_ADMIN_PASSWORD="your_secure_admin_password_min_8_chars"

# ─── TEST & DEVELOPMENT HELPERS ───────────────────────────────────────────────
TEST_TENANT_ID="your_test_tenant_id_here"

