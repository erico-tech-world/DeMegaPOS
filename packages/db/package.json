{
    "name": "@demegapos/db",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "prisma generate && node sync-client.cjs && tsc",
        "db:generate": "prisma generate && node sync-client.cjs",
