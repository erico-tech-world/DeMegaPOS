        "studio": "prisma studio"
    },
    "prisma": {
        "seed": "tsx seed.ts"
    },
    "dependencies": {
        "@prisma/client": "^6.2.1",
        "bcryptjs": "^2.4.3",
        "dotenv": "^17.2.4"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "latest",
        "prisma": "^6.2.1",
        "tsx": "latest",
        "typescript": "latest"
    }
